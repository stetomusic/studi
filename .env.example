# Kopiere diese Datei nach ".env.local" und trage die Werte aus der
# Entra-App-Registrierung ein. ".env.local" wird NICHT ins Repo committet.

# Anwendungs-ID (Client-ID) der App-Registrierung
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Verzeichnis-ID (Mandanten-ID / Tenant-ID) der PH Burgenland
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# Muss exakt einer Umleitungs-URI (Plattform "Single-Page-Anwendung") entsprechen
VITE_ENTRA_REDIRECT_URI=http://localhost:5173/

# Speiseplan (aus dem Repo stetomusic/mensa)
VITE_MENSA_URL=https://mensa.pphb.at/menu.json
